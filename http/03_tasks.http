# ─────────────────────────────────────────────────────────────────────────────
# ADMIN creates a task (admin-owned)
# ─────────────────────────────────────────────────────────────────────────────

### [ADMIN] Create task — returns 201; save the "id" as @admin_task_id below
POST http://localhost:8080/api/v1/tasks
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "title":       "Admin Task",
  "description": "A task created by admin",
  "status":      "pending"
}

